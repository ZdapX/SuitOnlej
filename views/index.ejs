<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suit Online - Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f1f5f9; color: #0f172a; }
        .card { background: white; border-radius: 20px; border: 1px solid #e2e8f0; }
        .btn-action { transition: all 0.2s; cursor: pointer; }
        .btn-action:hover { transform: scale(1.05); }
        .btn-action:active { transform: scale(0.95); }
        .hand-btn { font-size: 2.5rem; padding: 1.5rem; background: #f8fafc; border-radius: 24px; border: 2px solid transparent; transition: 0.2s; }
        .hand-btn:hover { background: #e2e8f0; }
        .hand-btn.selected { border-color: #6366f1; background: #eef2ff; }
        .chat-box { height: 150px; overflow-y: auto; scrollbar-width: thin; }
        .hidden { display: none; }
    </style>
</head>
<body class="antialiased p-4">

    <div id="app" class="max-w-md mx-auto">
        <!-- Input Nama -->
        <div id="name-screen" class="mt-10 space-y-6">
            <h1 class="text-4xl font-extrabold tracking-tight">Suit <span class="text-indigo-600">Online.</span></h1>
            <div class="card p-6 shadow-xl shadow-indigo-100">
                <p class="text-sm font-bold text-slate-500 mb-2">SIAPA NAMA KAMU?</p>
                <input type="text" id="player-name" class="w-full text-lg font-semibold border-2 border-slate-100 p-4 rounded-2xl outline-none focus:border-indigo-500 transition-all" placeholder="Ketik nama...">
                <button onclick="saveName()" class="w-full mt-4 bg-indigo-600 text-white font-bold p-4 rounded-2xl shadow-lg shadow-indigo-200 btn-action">Mulai Bermain</button>
            </div>
        </div>

        <!-- Lobby -->
        <div id="lobby-screen" class="hidden space-y-6">
            <div class="flex justify-between items-center py-4">
                <div>
                    <h2 class="text-2xl font-extrabold" id="welcome-user">Halo!</h2>
                    <p class="text-sm text-slate-500">Siap untuk menang hari ini?</p>
                </div>
                <button onclick="logout()" class="p-2 bg-white border rounded-xl text-xs font-bold text-red-500">Keluar</button>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <button onclick="createRoom()" class="card p-6 text-center hover:border-indigo-500 transition-all shadow-sm">
                    <div class="w-12 h-12 bg-indigo-50 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">⚡</div>
                    <p class="font-bold">Buat Room</p>
                </button>
                <button onclick="joinByCode()" class="card p-6 text-center hover:border-indigo-500 transition-all shadow-sm">
                    <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">🔑</div>
                    <p class="font-bold">Kode Room</p>
                </button>
            </div>

            <div class="pt-4">
                <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-3">Room Publik</h3>
                <div id="room-list" class="space-y-3"></div>
            </div>
        </div>

        <!-- Game Screen -->
        <div id="game-screen" class="hidden space-y-4">
            <!-- Scoreboard -->
            <div class="card p-4 bg-indigo-600 text-white flex justify-between items-center shadow-lg">
                <div class="text-center flex-1">
                    <p class="text-[10px] opacity-70 font-bold uppercase">Kamu</p>
                    <p id="my-score" class="text-2xl font-black">0</p>
                </div>
                <div class="px-4 border-l border-r border-indigo-400 text-xs font-bold">VS</div>
                <div class="text-center flex-1">
                    <p class="text-[10px] opacity-70 font-bold uppercase" id="opp-name-label">Lawan</p>
                    <p id="opp-score" class="text-2xl font-black">0</p>
                </div>
            </div>

            <!-- Game Area -->
            <div class="card p-6 text-center shadow-sm relative overflow-hidden">
                <div id="game-status-pill" class="inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold mb-4">
                    Menunggu lawan...
                </div>
                
                <div id="player-controls" class="flex justify-center gap-4 py-4">
                    <button id="btn-rock" onclick="play('rock')" class="hand-btn btn-action">✊</button>
                    <button id="btn-paper" onclick="play('paper')" class="hand-btn btn-action">🖐️</button>
                    <button id="btn-scissors" onclick="play('scissors')" class="hand-btn btn-action">✌️</button>
                </div>

                <div id="admin-controls" class="mt-4 border-t pt-4 hidden">
                    <!-- Tombol Kick muncul di sini jika owner -->
                </div>
            </div>

            <!-- Quick Chat -->
            <div class="card p-4 shadow-sm">
                <div id="chat-content" class="chat-box space-y-2 mb-3 text-sm">
                    <p class="text-slate-400 italic text-center">Chat di sini...</p>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="chat-input" class="flex-1 border-2 border-slate-50 p-2 rounded-xl text-sm outline-none focus:border-indigo-500" placeholder="Pesan...">
                    <button onclick="sendChat()" class="bg-indigo-600 text-white px-4 rounded-xl font-bold">Kirim</button>
                </div>
            </div>

            <button onclick="location.reload()" class="w-full text-slate-400 text-sm font-bold py-2">Keluar dari Room</button>
        </div>
    </div>

    <script>
        const socket = io();
        let myName = localStorage.getItem('suit-name');
        let roomCode = null;

        if(myName) { showLobby(); }

        function saveName() {
            const input = document.getElementById('player-name').value;
            if(!input) return alert("Isi nama dulu!");
            localStorage.setItem('suit-name', input);
            myName = input;
            showLobby();
        }

        function showLobby() {
            document.getElementById('name-screen').classList.add('hidden');
            document.getElementById('lobby-screen').classList.remove('hidden');
            document.getElementById('welcome-user').innerText = `Halo, ${myName}!`;
        }

        function logout() {
            localStorage.clear();
            location.reload();
        }

        function createRoom() { socket.emit('create-room', { playerName: myName }); }
        function joinByCode() {
            const code = prompt("Masukkan Kode Room:");
            if(code) socket.emit('join-room', { playerName: myName, roomCode: code.toUpperCase() });
        }

        function joinRoom(code) { socket.emit('join-room', { playerName: myName, roomCode: code }); }

        function play(move) {
            socket.emit('make-move', { roomCode, move });
            document.querySelectorAll('.hand-btn').forEach(b => b.classList.remove('selected'));
            document.getElementById('btn-'+move).classList.add('selected');
            document.getElementById('game-status-pill').innerText = "Sudah memilih!";
            disableHands(true);
        }

        function disableHands(status) {
            document.querySelectorAll('.hand-btn').forEach(b => {
                b.disabled = status;
                b.style.opacity = status ? "0.5" : "1";
            });
        }

        function sendChat() {
            const input = document.getElementById('chat-input');
            if(!input.value) return;
            socket.emit('send-chat', { roomCode, message: input.value, sender: myName });
            input.value = "";
        }

        socket.on('room-created', (room) => {
            roomCode = room.code;
            document.getElementById('lobby-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
        });

        socket.on('player-joined', (room) => {
            roomCode = room.code;
            document.getElementById('lobby-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
            
            const opponent = room.players.find(p => p.id !== socket.id);
            if(opponent) {
                document.getElementById('opp-name-label').innerText = opponent.name;
                document.getElementById('game-status-pill').innerText = "Lawan sudah masuk. Pilih senjata!";
                
                // Admin feature
                const adminDiv = document.getElementById('admin-controls');
                if(socket.id === room.ownerId) {
                    adminDiv.classList.remove('hidden');
                    adminDiv.innerHTML = `<button onclick="kick('${opponent.id}')" class="text-xs text-red-500 font-bold border border-red-100 px-4 py-1 rounded-full">KICK LAWAN</button>`;
                }
            }
        });

        socket.on('opponent-moved', () => {
            document.getElementById('game-status-pill').innerText = "LAWAN SUDAH MEMILIH!";
            document.getElementById('game-status-pill').className = "inline-block px-4 py-1 rounded-full bg-emerald-500 text-white text-xs font-bold mb-4";
        });

        socket.on('game-result', ({ players }) => {
            const me = players.find(p => p.id === socket.id);
            const opp = players.find(p => p.id !== socket.id);
            
            document.getElementById('my-score').innerText = me.score;
            document.getElementById('opp-score').innerText = opp.score;

            setTimeout(() => {
                alert(`HASIL:\nKamu: ${me.move}\nLawan: ${opp.move}`);
                resetRound();
            }, 500);
        });

        function resetRound() {
            disableHands(false);
            document.querySelectorAll('.hand-btn').forEach(b => b.classList.remove('selected'));
            document.getElementById('game-status-pill').innerText = "Pilih lagi!";
            document.getElementById('game-status-pill').className = "inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold mb-4";
        }

        socket.on('receive-chat', ({ message, sender }) => {
            const box = document.getElementById('chat-content');
            const isMe = sender === myName;
            box.innerHTML += `<div class="${isMe ? 'text-right' : 'text-left'}">
                <span class="text-[10px] font-bold block text-slate-400">${sender}</span>
                <span class="inline-block ${isMe ? 'bg-indigo-600 text-white' : 'bg-slate-100'} px-3 py-1 rounded-xl">${message}</span>
            </div>`;
            box.scrollTop = box.scrollHeight;
        });

        socket.on('update-room-list', (rooms) => {
            const list = document.getElementById('room-list');
            list.innerHTML = rooms.length ? "" : "<p class='text-xs text-slate-400'>Belum ada room publik...</p>";
            rooms.forEach(r => {
                list.innerHTML += `<div class="card p-4 flex justify-between items-center bg-white">
                    <div>
                        <p class="font-bold text-indigo-600 text-sm">${r.code}</p>
                        <p class="text-[10px] text-slate-400">Host: ${r.players[0].name}</p>
                    </div>
                    <button onclick="joinRoom('${r.code}')" class="text-xs bg-slate-900 text-white px-4 py-2 rounded-xl font-bold">GABUNG</button>
                </div>`;
            });
        });

        function kick(id) { socket.emit('kick-player', { roomCode, playerId: id }); }
        socket.on('kicked', () => { alert("Kamu di-kick!"); location.reload(); });
        socket.on('notification', (m) => console.log(m));
        socket.on('error-msg', (m) => alert(m));
    </script>
</body>
</html>
