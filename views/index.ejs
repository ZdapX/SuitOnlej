<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suit Online - Modern</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Ganti ke CDN agar lebih stabil di Vercel -->
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .hidden { display: none !important; }
        .card { background: white; border: 1px solid #e2e8f0; border-radius: 24px; }
        .hand-btn { font-size: 2.5rem; background: #f1f5f9; padding: 1.5rem; border-radius: 20px; transition: 0.2s; border: 2px solid transparent; }
        .hand-btn:hover:not(:disabled) { transform: translateY(-5px); background: #e2e8f0; }
        .hand-btn.selected { border-color: #4f46e5; background: #eef2ff; }
    </style>
</head>
<body class="p-4">

    <div class="max-w-md mx-auto">
        
        <!-- SCREEN 1: INPUT NAMA -->
        <div id="div-name" class="mt-20">
            <h1 class="text-3xl font-extrabold text-slate-900 mb-6">Suit Online.</h1>
            <div class="card p-6 shadow-sm">
                <p class="text-[10px] font-bold text-slate-400 mb-2 uppercase tracking-widest">Nama Player</p>
                <input type="text" id="inp-name" class="w-full p-4 border rounded-xl mb-4 font-bold outline-none focus:border-indigo-500" placeholder="Ketik nama kamu...">
                <button onclick="handleSaveName()" class="w-full bg-indigo-600 text-white font-bold p-4 rounded-xl shadow-lg">Masuk Ke Game</button>
            </div>
        </div>

        <!-- SCREEN 2: LOBBY -->
        <div id="div-lobby" class="hidden">
            <div class="flex justify-between items-center py-6">
                <h2 id="txt-welcome" class="text-xl font-bold text-slate-800">Halo!</h2>
                <button onclick="handleLogout()" class="text-red-500 text-xs font-bold">Ganti Nama</button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-8">
                <button onclick="handleCreateRoom()" class="card p-6 text-center hover:border-indigo-500 transition">
                    <span class="block text-2xl mb-2">➕</span>
                    <span class="font-bold text-sm">Buat Room</span>
                </button>
                <button onclick="handleJoinByCode()" class="card p-6 text-center hover:border-indigo-500 transition">
                    <span class="block text-2xl mb-2">🔑</span>
                    <span class="font-bold text-sm">Join Kode</span>
                </button>
            </div>
            <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4">Room Publik Aktif</h3>
            <div id="list-room-container" class="space-y-3"></div>
        </div>

        <!-- SCREEN 3: GAME -->
        <div id="div-game" class="hidden space-y-4">
            <!-- Score -->
            <div class="card bg-slate-900 p-4 flex justify-between items-center text-white shadow-xl">
                <div class="text-center flex-1">
                    <p class="text-[9px] font-bold opacity-50">KAMU</p>
                    <p id="txt-score-me" class="text-2xl font-black">0</p>
                </div>
                <div class="text-indigo-400 font-bold mx-4">VS</div>
                <div class="text-center flex-1">
                    <p id="txt-name-opp" class="text-[9px] font-bold opacity-50">LAWAN</p>
                    <p id="txt-score-opp" class="text-2xl font-black">0</p>
                </div>
            </div>

            <!-- Play Area -->
            <div class="card p-8 text-center shadow-sm">
                <div id="pill-status" class="inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold mb-6 uppercase tracking-tighter">
                    Menunggu lawan bergabung...
                </div>
                <div class="flex justify-center gap-4 mb-4">
                    <button id="btn-rock" onclick="handlePlay('rock')" class="hand-btn">✊</button>
                    <button id="btn-paper" onclick="handlePlay('paper')" class="hand-btn">🖐️</button>
                    <button id="btn-scissors" onclick="handlePlay('scissors')" class="hand-btn">✌️</button>
                </div>
                <p id="txt-move-info" class="text-xs font-bold text-indigo-600 h-4"></p>
                <div id="div-admin" class="mt-6 pt-4 border-t hidden"></div>
            </div>

            <!-- Chat Area -->
            <div class="card p-4 shadow-sm">
                <div id="div-chat-box" class="h-32 overflow-y-auto mb-3 flex flex-col gap-2 p-1"></div>
                <div class="flex gap-2">
                    <input type="text" id="inp-chat" class="flex-1 bg-slate-50 p-3 rounded-xl text-sm outline-none focus:bg-white border border-transparent focus:border-indigo-200" placeholder="Kirim chat ke lawan...">
                    <button onclick="handleSendChat()" class="bg-indigo-600 text-white px-5 rounded-xl text-xs font-bold">KIRIM</button>
                </div>
            </div>

            <button onclick="location.reload()" class="w-full text-slate-400 text-[10px] font-bold py-4">EXIT GAME</button>
        </div>
    </div>

    <script>
        const socket = io();
        let myName = localStorage.getItem('suit-name');
        let currentRoom = null;

        // Cek Nama Saat Awal
        window.onload = () => {
            if (myName) {
                document.getElementById('div-name').classList.add('hidden');
                document.getElementById('div-lobby').classList.remove('hidden');
                document.getElementById('txt-welcome').innerText = `Halo, ${myName}!`;
            }
        };

        function handleSaveName() {
            const nameValue = document.getElementById('inp-name').value.trim();
            if (!nameValue) return alert("Nama jangan kosong!");
            
            localStorage.setItem('suit-name', nameValue);
            myName = nameValue;
            
            // Pindah Screen
            document.getElementById('div-name').classList.add('hidden');
            document.getElementById('div-lobby').classList.remove('hidden');
            document.getElementById('txt-welcome').innerText = `Halo, ${myName}!`;
        }

        function handleLogout() {
            localStorage.clear();
            location.reload();
        }

        // Room Logic
        function handleCreateRoom() { socket.emit('create-room', { playerName: myName }); }
        function handleJoinByCode() {
            const code = prompt("Masukkan Kode Room:");
            if (code) socket.emit('join-room', { playerName: myName, roomCode: code.toUpperCase() });
        }
        function handleJoinRoom(code) { socket.emit('join-room', { playerName: myName, roomCode: code }); }

        // Game Logic
        function handlePlay(move) {
            if (!currentRoom) return;
            socket.emit('make-move', { roomCode: currentRoom.code, move });
            
            document.querySelectorAll('.hand-btn').forEach(b => b.disabled = true);
            document.getElementById('btn-' + move).classList.add('selected');
            document.getElementById('txt-move-info').innerText = "Sudah memilih, menunggu lawan...";
        }

        function handleSendChat() {
            const msg = document.getElementById('inp-chat').value;
            if (!msg || !currentRoom) return;
            socket.emit('send-chat', { roomCode: currentRoom.code, message: msg, sender: myName });
            document.getElementById('inp-chat').value = "";
        }

        // Socket Event Listeners
        socket.on('room-created', (room) => {
            currentRoom = room;
            document.getElementById('div-lobby').classList.add('hidden');
            document.getElementById('div-game').classList.remove('hidden');
        });

        socket.on('player-joined', (room) => {
            currentRoom = room;
            document.getElementById('div-lobby').classList.add('hidden');
            document.getElementById('div-game').classList.remove('hidden');
            
            const opp = room.players.find(p => p.id !== socket.id);
            if (opp) {
                document.getElementById('txt-name-opp').innerText = opp.name.toUpperCase();
                document.getElementById('pill-status').innerText = "SIAP BERTANDING!";
                
                if (socket.id === room.ownerId) {
                    const admin = document.getElementById('div-admin');
                    admin.classList.remove('hidden');
                    admin.innerHTML = `<button onclick="handleKick('${opp.id}')" class="text-[10px] text-red-500 font-bold border border-red-100 px-4 py-1 rounded-full hover:bg-red-50">KICK LAWAN</button>`;
                }
            }
        });

        socket.on('opponent-moved', () => {
            const pill = document.getElementById('pill-status');
            pill.innerText = "LAWAN SUDAH PILIH!";
            pill.className = "inline-block px-4 py-1 rounded-full bg-green-500 text-white text-[10px] font-bold mb-6 uppercase";
        });

        socket.on('game-result', ({ players }) => {
            const me = players.find(p => p.id === socket.id);
            const opp = players.find(p => p.id !== socket.id);
            
            document.getElementById('txt-score-me').innerText = me.score;
            document.getElementById('txt-score-opp').innerText = opp.score;

            setTimeout(() => {
                const emo = { rock: '✊', paper: '🖐️', scissors: '✌️' };
                alert(`RONDE SELESAI!\nKamu: ${emo[me.move]}\nLawan: ${emo[opp.move]}`);
                
                // Reset UI ronde
                document.querySelectorAll('.hand-btn').forEach(b => {
                    b.disabled = false;
                    b.classList.remove('selected');
                });
                document.getElementById('txt-move-info').innerText = "";
                const pill = document.getElementById('pill-status');
                pill.innerText = "PILIH LAGI!";
                pill.className = "inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold mb-6 uppercase";
            }, 500);
        });

        socket.on('receive-chat', ({ message, sender }) => {
            const box = document.getElementById('div-chat-box');
            const isMe = sender === myName;
            box.innerHTML += `
                <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'}">
                    <span class="text-[9px] text-slate-400 font-bold mb-1">${sender}</span>
                    <span class="px-4 py-2 rounded-2xl text-sm ${isMe ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}">${message}</span>
                </div>
            `;
            box.scrollTop = box.scrollHeight;
        });

        socket.on('update-room-list', (rooms) => {
            const container = document.getElementById('list-room-container');
            container.innerHTML = rooms.length ? "" : "<p class='text-xs text-slate-400 text-center italic'>Tidak ada room publik...</p>";
            rooms.forEach(r => {
                container.innerHTML += `
                    <div class="card p-4 flex justify-between items-center shadow-sm hover:border-indigo-200 transition">
                        <div>
                            <p class="font-bold text-sm text-indigo-600">${r.code}</p>
                            <p class="text-[10px] text-slate-400">Host: ${r.players[0].name}</p>
                        </div>
                        <button onclick="handleJoinRoom('${r.code}')" class="text-xs bg-slate-900 text-white px-4 py-2 rounded-xl font-bold">GABUNG</button>
                    </div>
                `;
            });
        });

        function handleKick(id) { socket.emit('kick-player', { roomCode: currentRoom.code, playerId: id }); }
        socket.on('kicked', () => { alert("Kamu di-kick!"); location.reload(); });
        socket.on('error-msg', (msg) => alert(msg));
    </script>
</body>
</html>
